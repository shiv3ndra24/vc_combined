# Copy to vc_qoe.env (same folder as run.sh), fill in, then:  chmod 600 vc_qoe.env
# run.sh loads it with the shell, and the URL contains '&', so the URL MUST be in double quotes.
#
# ONE common InfluxDB 2 target for Zoom, Teams and Meet (decision 2026-11-06).
# Measurements: session_metrics, rtp_stream, capture_health (+ Zoom's client_no_media,
# session_summary, capture_health_core); tag platform = zoom | teams | meet.
VC_QOE_INFLUX_URL="http://10.238.80.90:8087/api/v2/write?org=teams&bucket=vc_qoe&precision=ns"
VC_QOE_INFLUX_TOKEN="put-a-write-only-token-for-bucket-vc_qoe-here"

# OPTIONAL: separate one engine into its own bucket (docs/USAGE.md section 6.3). Leave commented
# for the common target. A separated engine uses its own token if given, else the common one.
# VC_QOE_ZOOM_INFLUX_URL="http://10.238.80.90:8087/api/v2/write?org=teams&bucket=zoom_qoe&precision=ns"
# VC_QOE_ZOOM_INFLUX_TOKEN="write-only-token-for-zoom_qoe"
# VC_QOE_TEAMS_MEET_INFLUX_URL="http://10.238.80.90:8087/api/v2/write?org=teams&bucket=qoe&precision=ns"
# VC_QOE_TEAMS_MEET_INFLUX_TOKEN="write-only-token-for-qoe"
#
# Never commit the filled-in file or paste the token into a chat or a ticket.
